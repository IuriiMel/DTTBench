<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1200.0" style="-fx-font-family: 'Consolas'; -fx-font-size: 12px;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.terminal.controller.MainController">

   <top>
      <BorderPane style="-fx-background-color: #f5f5f5; -fx-padding: 5;">
         <left>
            <MenuBar>
               <Menu text="Tools">
                  <MenuItem onAction="#commandList" text="Command List" />
                  <MenuItem onAction="#config" text="Config" />
               </Menu>
               <Menu text="Help">
                  <MenuItem onAction="#syntax" text="Syntax" />
                  <MenuItem onAction="#about" text="About" />
               </Menu>
            </MenuBar>
         </left>
         <right>
            <ComboBox fx:id="mode" prefWidth="150.0" BorderPane.alignment="CENTER">
               <tooltip>
                  <Tooltip text="List of available modes" />
               </tooltip>
            </ComboBox>
         </right>
      </BorderPane>
   </top>

</BorderPane>
